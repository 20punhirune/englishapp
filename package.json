{
  "name": "flash-english",
  "version": "1.0.0",
  "private": true,
  "description": "Japanese -> English flash composition trainer (offline-capable PWA)",
  "scripts": {
    "build:css": "tailwindcss -i ./src/input.css -o ./style.css --minify",
    "build:js": "esbuild src/main.jsx --bundle --minify --format=iife --jsx=automatic --target=es2019 --outfile=app.js",
    "build": "npm run build:css && npm run build:js",
    "watch:css": "tailwindcss -i ./src/input.css -o ./style.css --watch",
    "watch:js": "esbuild src/main.jsx --bundle --format=iife --jsx=automatic --target=es2019 --outfile=app.js --watch",
    "serve": "npx --yes http-server -p 5173 -c-1 ."
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "tailwindcss": "^3.4.17"
  }
}
